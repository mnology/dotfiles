# OS
# Ignore bin/ contents, but keep the tinty Meld theme generator tracked.
# Use bin/* (not bin/) so git descends and honors the negation below.
bin/*
!bin/meld-tinty.py
!bin/kiro-tinty.py
!bin/win-sync.py
!bin/prezto-template-diff.sh
.DS_Store
Thumbs.db

