[user]
  email = ejohanse@users.noreply.github.com
  name = Erik Johansen

[core]
  # Use the tracked global ignore file. Edit messages in Neovide.
  # --no-fork makes Neovide block, so Git waits for the message.
  excludesfile = ~/.gitignore_global
  editor = v --no-fork
  pager = delta
  packedGitWindowSize = 16m
  packedGitLimit = 128m

[interactive]
  diffFilter = delta --color-only

[color]
  ui = true

[delta]
  navigate = true
  line-numbers = true
  syntax-theme = ansi

  # no background tint on whole lines (ANSI has no subtle dark red/green);
  # only the changed words get a solid ANSI background
  minus-style = syntax
  plus-style = syntax
  minus-emph-style = 0 1 bold
  plus-emph-style = 0 2 bold

  line-numbers-minus-style = 1
  line-numbers-plus-style = 2
  line-numbers-zero-style = 8
  line-numbers-left-style = 8
  line-numbers-right-style = 8

  file-style = 4 bold
  file-decoration-style = 4 ul
  hunk-header-style = syntax
  hunk-header-decoration-style = 8 box

[alias]
  # Short daily commands.
  au = add -u
  co = checkout
  st = status
  cane = commit --amend --no-edit
  fwl = push --force-with-lease
  # Iterate on one issue: stage tracked changes, amend, and force-push safely.
  iter = !git au && git cane && git fwl
  # Log views.
  lol = log --graph --decorate --pretty=oneline --abbrev-commit
  lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
  flog = foresta --style=10 --reverse
  # Submodule helpers.
  surm = submodule update --remote --merge --jobs 12
  ms = !git submodule update && git surm

[diff]
  tool = meld

[difftool]
  prompt = false

[merge]
  tool = meld

[mergetool]
  prompt = false

[branch]
  autosetupmerge = true
  autoSetupRebase = remote

[push]
  default = simple
  autoSetupRemote = true

[pull]
  rebase = true

[pack]
  windowMemory = 512m

[init]
  templateDir = ~/.git-template

[credential "https://"]
  # Use the GitLab CLI as the HTTPS credential helper.
  helper =
  helper = !/usr/bin/glab auth git-credential

[gui]
  fontui = -family \"Source Code Pro for Powerline\" -size 9 -weight normal -slant roman -underline 0 -overstrike 0
  fontdiff = -family \"Source Code Pro for Powerline\" -size 9 -weight normal -slant roman -underline 0 -overstrike 0
