# SSH client config (committed skeleton).
#
# All host entries live in ~/.ssh/config.local, which is NOT committed.
# See .ssh/config.local.example for the format.
#
# Include must come first: ssh uses the FIRST value found for each option, so
# local host blocks override the global Host * defaults below.
Include ~/.ssh/config.local

#
# Global defaults
#
Host *
  # Add a key to the agent on first use instead of eager login-time loading.
  AddKeysToAgent      yes
  # Offer only the IdentityFile named for a host. Stops ssh from presenting
  # every agent key to every server (avoids key leaks and auth lockouts).
  IdentitiesOnly      yes
  # X11 forwarding is NOT global. Enable it per-host in config.local, and
  # prefer ForwardX11 over ForwardX11Trusted so the remote cannot sniff the
  # local X server.
  ForwardX11          no
  Compression         yes
  TCPKeepAlive        yes
  ServerAliveInterval 120
